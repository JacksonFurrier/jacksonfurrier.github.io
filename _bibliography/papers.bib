@Article{Szűcs2025,
author={Sz{\H{u}}cs, {\'A}d{\'a}m Istv{\'a}n
and K{\'a}ri, B{\'e}la
and P{\'a}rtos, Oszk{\'a}r},
title={Myocardial perfusion imaging SPECT left ventricle segmentation with graphs},
journal={EJNMMI Physics},
year={2025},
month={Mar},
day={10},
volume={12},
number={1},
pages={21},
abstract={Various specialized and general collimators are used for myocardial perfusion imaging (MPI) with single-photon emission computed tomography (SPECT) to assess different types of coronary artery disease (CAD). Alongside the wide variability in imaging characteristics, the apriori ``learnt'' information of left ventricular (LV) shape can affect the final diagnosis of the imaging protocol. This study evaluates the effect of prior information incorporation into the segmentation process, compared to deep learning (DL) approaches, as well as the differences of 4 collimation techniques on 5 different datasets.},
issn={2197-7364},
doi={10.1186/s40658-025-00728-5},
url={https://doi.org/10.1186/s40658-025-00728-5},
keywords={adam, journal}
}

@inproceedings{10.1145/3774976.3774978,
author = {Ali, Haris and Szundefinedcs, Sz{\H{u}}cs, {\'A}d{\'a}m Istv{\'a}n and K\'{a}ri, B\'{e}la and P\'{a}rtos, Oszk\'{a}r},
title = {Attention on Shapes - A Myocardial Perfusion Imaging SPECT Segmentation Transformer with Shape Priors},
year = {2025},
isbn = {9798400715808},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3774976.3774978},
doi = {10.1145/3774976.3774978},
abstract = {The manual task of left ventricle (LV) delineation is one of the most time-consuming and circumstantial tasks of nuclear cardiologists and radiologists. Since the diagnosis in Myocardial Perfusion Imaging (MPI) inherently depends on the quality of the segmentation this procedure is performed warily to minimize human errors. The automation of the segmentation task is troublesome on several occasions. First there is the problem of low Signal-to-noise ratio (SNR) and limited resolution, second there is a large variability in patient cardiac uptake and imaging equipment and third there is no standard notion of left ventricle outlines and shapes in the field solely based on the distribution image. This work aims to give solutions to all these problems by combining Transformer architecture with Statistical Shape Prior (SSP) technique to overcome the caveats of transformers in a low labeled patient cardinality setting. As a result, the proposed algorithm showed a great, (gt 5\%) improvement in all the segmentation classification metrics compared to the State-of-the-Art (SOTA) methods on simulated and real-world patient dataset too. Alongside with the increased performance in metrics the involvement of shape prior information revealed further characteristics about LV shapes in MPI Single-Photon Emission Computed Tomography (SPECT) settings. In conclusion the network is capable of outperforming the current solutions on the field by automating the segmentation task, whilst revealing more about the nature of left ventricle shapes.},
booktitle = {Proceedings of the 12th International Conference on Bioinformatics Research and Applications},
pages = {10–15},
numpages = {6},
keywords = {Myocardial Perfusion Imaging • Single-Photon Emission Computed Tomography • Coronary Artery Disease • Vision Transformers • Statistical Shape Priors},
location = {
},
series = {ICBRA '25}
}